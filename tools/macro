#!/bin/sh
# macro: run a stored macro or a few lines of script through Macro Recorder (Mantra) and wait for the answer (v5, 31.10.2026)
#   macro run "<name>"            play ~/.mantra_macro/macros/<name>.ahk (recalibrated first if its window moved, v8)
#   macro do 'Click 100, 200'      run these lines (AutoHotkey v2 syntax, docs/SCRIPT.md)
#   macro do - < file.ahk          run a script from stdin
#   macro recalibrate "<name>"     move the macro's clicks to where its window is now; prints the report (v8)
#   macro view "<name>" ["App"]    store the view now: the windows under its clicks (only App's, if given) (v8)
#   macro ax-read "<app>"  /  macro ax-press "<app>" "<label>"  /  macro ax-quit "<app>"   (v10, the Star API)
#   macro capture-page "x,y,w,h"|front [down|up] [file.png]   the whole page as one picture, scrolled and stitched (v11)
#   macro capture-window "<app or title>" [file.png]   that window's own pixels, also on another Space or behind others (v13)
#   macro capture-screen <display name part | 1,2..> [file.png]   /   macro capture-rect "x,y,w,h" [file.png]   (v13)
#     captures go to ~/.mantra_macro/captures/ unless a file is given; prints the path
#   macro ocr [screen|window:<app>|rect:x,y,w,h] [--json]   the text on screen, lines with their middle x,y (Apple Vision, v19)
#   macro find-text "<text>" [area]  /  macro click-text "<text>" [area]  /  macro wait-text "<text>" [secs] [area]
#   macro win-list   /   macro win-move <x|-> <y|-> <w|-> <h|-> "<title>"   (v20, Rectangle's engine, Accessibility only)
#   macro win-snap "<title>" <action> [display]   action: left-half right-half top-half bottom-half maximize almost-maximize center
#     first-third center-third last-third first-two-thirds last-two-thirds top-left top-right bottom-left bottom-right
#     next-display previous-display; display = number or name part ("BenQ", "MacBook")
#   macro win-minimize|win-maximize|win-restore|win-top|win-bottom "<title>"
#   macro layout new|save|run|delete "<name>"  /  macro layout list   every visible window's place, brought back (opens missing apps) (v21)
#   macro trigger "<name>" [key] [on|off]   that macro's own key (f1, ctrl+alt+k) on or off; no key/state = report (v14)
#   macro record "<name>"  /  macro stop     record a new macro under that name, and stop and save it (v8)
#   macro has "<what you want to do>"   is it already stored? (the catalogue ~/Developer/MACRO_SKILLS, 12.11.2026); also: macro skills list|show|run|add|sync
# Prints ok or the error (recalibrate and view print their report); exit 0 on ok. Waits up to MACRO_TIMEOUT seconds (default 120).
case "$1" in has) shift; exec macroskill has "$@" ;; skills) shift; exec macroskill "$@" ;; esac
IN="$HOME/.mantra_macro/inbox"; mkdir -p "$IN"
id="$(date +%s)-$$"
case "$1" in
  run) printf 'run: %s\n' "$2" > "$IN/$id.part" ;;
  do)  if [ "$2" = "-" ]; then cat > "$IN/$id.part"; else printf '%s\n' "$2" > "$IN/$id.part"; fi ;;
  record) printf 'record: %s\n' "$2" > "$IN/$id.part" ;;
  stop) printf 'stop:\n' > "$IN/$id.part" ;;
  recalibrate) printf 'recalibrate: %s\n' "$2" > "$IN/$id.part" ;;
  capture-page) printf 'capture-page: %s | %s | %s\n' "$2" "${3:-down}" "${4:-$HOME/Desktop/page.png}" > "$IN/$id.part" ;;
  capture-window|capture-screen|capture-rect) printf '%s: %s | %s\n' "$1" "$2" "$3" > "$IN/$id.part" ;;
  ocr) a="${2:-screen}"; case "$a" in --json) a=screen; j=json;; esac; [ "$3" = "--json" ] && j=json; printf 'ocr: %s | %s\n' "$a" "${j:-text}" > "$IN/$id.part" ;;
  find-text|click-text) printf '%s: %s | %s\n' "$1" "$2" "${3:-screen}" > "$IN/$id.part" ;;
  wait-text) printf 'wait-text: %s | %s | %s\n' "$2" "${3:-10}" "${4:-screen}" > "$IN/$id.part"; MACRO_TIMEOUT=$(( ${3:-10} + 30 )) ;;
  win-list) printf 'win-list:\n' > "$IN/$id.part" ;;
  win-move) m() { [ "$1" = "-" ] && echo "" || echo "$1"; }; printf 'win-move: %s | %s | %s | %s | %s\n' "$(m "$2")" "$(m "$3")" "$(m "$4")" "$(m "$5")" "$6" > "$IN/$id.part" ;;
  win-snap) printf 'win-snap: %s | %s | %s\n' "$2" "$3" "$4" > "$IN/$id.part" ;;
  win-minimize|win-maximize|win-restore|win-top|win-bottom) printf '%s: %s\n' "$1" "$2" > "$IN/$id.part" ;;
  layout) printf 'layout-%s: %s\n' "$2" "$3" > "$IN/$id.part" ;;
  trigger) printf 'trigger: %s | %s | %s\n' "$2" "$3" "$4" > "$IN/$id.part" ;;
  ax-read|ax-quit) printf '%s: %s\n' "$1" "$2" > "$IN/$id.part" ;;
  ax-focus-end) printf 'ax-focus-end: %s | %s | %s\n' "$2" "${3:-textarea}" "${4:-1}" > "$IN/$id.part" ;;
  ax-press) printf 'ax-press: %s | %s\n' "$2" "$3" > "$IN/$id.part" ;;
  view) if [ -n "$3" ]; then printf 'view: %s | %s\n' "$2" "$3" > "$IN/$id.part"; else printf 'view: %s\n' "$2" > "$IN/$id.part"; fi ;;
  *) sed -n "2,26p" "$0"; exit 2 ;;
esac
# Keyboard and Mouse Guard (Marko, 12.11.2026: "the same guard ... must be used by the macro recorder: guard on and guard off").
# Actions that move the mouse or press keys hold Marko's physical mouse and keyboard while they run (Esc Esc Esc gives them
# back). If he has taken over, nothing is done. No guard app installed / no permission: the action runs as before.
# MACRO_GUARD=0 skips it.
case "$1" in
  run|do|click-text)
    if [ "${MACRO_GUARD:-1}" != 0 ] && command -v kmguard >/dev/null 2>&1; then
      kmguard on $(( ${MACRO_TIMEOUT:-120} + 10 )) macro >/dev/null 2>&1; g=$?
      if [ $g = 2 ]; then
        rm -f "$IN/$id.part"
        echo "Marko has taken the mouse and keyboard (Esc Esc Esc): not done. Ask him; 'kmguard clear' when he says done."
        exit 5
      fi
      [ $g = 0 ] && trap 'kmguard off macro >/dev/null 2>&1' EXIT
    fi ;;
esac
mv "$IN/$id.part" "$IN/$id.ahk"
pgrep -xq MacroRecorder || { echo "Macro Recorder is not running (open it from Applications)"; rm -f "$IN/$id.ahk"; exit 3; }
t=0; lim=$(( ${MACRO_TIMEOUT:-120} * 10 ))
while [ ! -f "$IN/$id.result.json" ]; do sleep 0.1; t=$((t+1)); [ $t -ge $lim ] && { echo "no answer in ${MACRO_TIMEOUT:-120} s"; exit 4; }; done
f="$IN/$id.result.json"; r=$(cat "$f")
msg=$(plutil -extract message raw -o - "$f" 2>/dev/null)
rm -f "$f"
case "$1:$r" in
  capture-*:*'"ok":true'*) printf '%s\n' "$msg"; exit 0 ;;
  capture-*:*) printf 'error: %s\n' "${msg:-$r}"; exit 1 ;;
  capture-page:*'"ok":true'*) printf '%s\n' "$msg"; exit 0 ;;
  capture-page:*) printf 'error: %s\n' "${msg:-$r}"; exit 1 ;;
  ocr:*'"ok":true'*|find-text:*'"ok":true'*|click-text:*'"ok":true'*|wait-text:*'"ok":true'*) printf '%s\n' "$msg"; exit 0 ;;
  ocr:*|find-text:*|click-text:*|wait-text:*) printf 'error: %s\n' "${msg:-$r}"; exit 1 ;;
  layout:*'"ok":true'*) printf '%s\n' "$msg"; exit 0 ;;
  layout:*) printf 'error: %s\n' "${msg:-$r}"; exit 1 ;;
  win-*:*'"ok":true'*) printf '%s\n' "$msg"; exit 0 ;;
  win-*:*) printf 'error: %s\n' "${msg:-$r}"; exit 1 ;;
  ax-*:*'"ok":true'*) printf '%s\n' "$msg"; exit 0 ;;
  ax-*:*) printf 'error: %s\n' "${msg:-$r}"; exit 1 ;;
  recalibrate:*'"ok":true'*|view:*'"ok":true'*|record:*'"ok":true'*|stop:*'"ok":true'*) printf '%s\n' "$msg"; exit 0 ;;
  *'"ok":true'*) echo ok; exit 0 ;;
  recalibrate:*|view:*|record:*|stop:*) printf 'error: %s\n' "${msg:-$r}"; exit 1 ;;
  *) echo "$r"; exit 1 ;;
esac
