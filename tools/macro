#!/bin/sh
# macro: run a stored macro or a few lines of script through Macro Recorder (Mantra) and wait for the answer (v5, 31.10.2026)
#   macro run "<name>"            play ~/.mantra_macro/macros/<name>.ahk
#   macro do 'Click 100, 200'      run these lines (AutoHotkey v2 syntax, docs/SCRIPT.md)
#   macro do - < file.ahk          run a script from stdin
# Prints ok or the error; exit 0 on ok. Waits up to MACRO_TIMEOUT seconds (default 120).
IN="$HOME/.mantra_macro/inbox"; mkdir -p "$IN"
id="$(date +%s)-$$"
case "$1" in
  run) printf 'run: %s\n' "$2" > "$IN/$id.part" ;;
  do)  if [ "$2" = "-" ]; then cat > "$IN/$id.part"; else printf '%s\n' "$2" > "$IN/$id.part"; fi ;;
  *) sed -n '2,6p' "$0"; exit 2 ;;
esac
mv "$IN/$id.part" "$IN/$id.ahk"
pgrep -xq MacroRecorder || { echo "Macro Recorder is not running (its row in the star starts it)"; rm -f "$IN/$id.ahk"; exit 3; }
t=0; lim=$(( ${MACRO_TIMEOUT:-120} * 10 ))
while [ ! -f "$IN/$id.result.json" ]; do sleep 0.1; t=$((t+1)); [ $t -ge $lim ] && { echo "no answer in ${MACRO_TIMEOUT:-120} s"; exit 4; }; done
r=$(cat "$IN/$id.result.json"); rm -f "$IN/$id.result.json"
case "$r" in *'"ok":true'*) echo ok; exit 0 ;; *) echo "$r"; exit 1 ;; esac
